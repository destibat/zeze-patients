# Environnement DEV — dev.zezepagnon.solutions
# Copier ce fichier en .env.dev et renseigner les valeurs

DB_ROOT_PASSWORD=rootpassword_dev_a_changer
DB_NAME=zeze_dev
DB_USER=zeze_dev
DB_PASSWORD=password_dev_a_changer

JWT_SECRET=jwt_secret_dev_a_changer_32_chars_min
JWT_REFRESH_SECRET=jwt_refresh_secret_dev_a_changer_32_chars_min

FRONTEND_URL=https://dev.zezepagnon.solutions

# Super-admin TOTP — générer avec : docker exec <backend> npm run setup-totp
SUPERADMIN_TOTP_SECRET=GENERER_VIA_SETUP_TOTP

# Chiffrement AES-256 de la clé Anthropic
IA_ENCRYPTION_KEY=changez_cette_cle_de_chiffrement_dev
