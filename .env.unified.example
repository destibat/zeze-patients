# Stack unifiée multi-tenant — copier en .env.unified et remplir les valeurs
# Un seul fichier .env pour les 3 cabinets (patients, alice, cisse)

# Base de données unique
DB_ROOT_PASSWORD=CHANGER_MOI
DB_NAME=zezepagnon_unified
DB_USER=zeze_unified
DB_PASSWORD=CHANGER_MOI

# JWT — générer avec : openssl rand -hex 64
JWT_SECRET=CHANGER_MOI
JWT_REFRESH_SECRET=CHANGER_MOI

# Toutes les origines front autorisées (séparées par des virgules)
FRONTEND_URL=https://patients.zezepagnon.solutions,https://alice.zezepagnon.solutions,https://cisse.zezepagnon.solutions

# Anthropic — clé partagée (chaque cabinet peut configurer la sienne via l'UI)
ANTHROPIC_API_KEY=CHANGER_MOI
ANTHROPIC_MODEL=claude-sonnet-4-6

# Super-admin — générer : openssl rand -hex 32
SUPERADMIN_SECRET=CHANGER_MOI

# Chiffrement AES-256 clé Anthropic — générer : openssl rand -hex 32
IA_ENCRYPTION_KEY=CHANGER_MOI
